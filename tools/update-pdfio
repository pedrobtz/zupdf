#!/bin/sh
# Re-vendor pdfio. Usage: tools/update-pdfio <version>   e.g. 1.6.5
#
# Downloads the release tarball from GitHub, records its SHA-256 and the
# commit the tag resolves to, copies the files listed in tools/pdfio-files.txt
# into src/vendor/pdfio/, applies tools/patches/*.patch in order and rewrites
# src/vendor/PROVENANCE. Run from the package root, then tools/verify-vendor,
# R CMD check and tools/check-symbols.
#
# From pdfio 1.6.0 the ttf library ships inside pdfio's own tree (ttf.c,
# ttf.h), so one tarball and one tree cover both (design section 9).
#
# Also update ZPD_PDFIO_VERSION in src/zpd_info.c; tools/verify-vendor fails
# until it matches.
set -eu

VERSION="${1:?usage: tools/update-pdfio <version>}"
REPO="michaelrsweet/pdfio"
URL="https://github.com/${REPO}/releases/download/v${VERSION}/pdfio-${VERSION}.tar.gz"
ROOT=$(pwd)
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT

echo "==> fetching $URL"
curl -fsSL --retry 3 --retry-delay 2 --retry-connrefused \
  -o "$WORK/pdfio.tar.gz" "$URL"
SHA=$(shasum -a 256 "$WORK/pdfio.tar.gz" | cut -d' ' -f1)
echo "==> sha256 $SHA"

# The tag is mutable; the commit it resolved to at import time is recorded
# so that a moved tag is noticed.
COMMIT=$(curl -fsSL --retry 3 \
  "https://api.github.com/repos/${REPO}/commits/v${VERSION}" |
  sed -n 's/^  "sha": "\([0-9a-f]*\)".*/\1/p' | head -n 1)
[ -n "$COMMIT" ] || { echo "could not resolve tag v$VERSION" >&2; exit 1; }
echo "==> tag v$VERSION is commit $COMMIT"

tar xzf "$WORK/pdfio.tar.gz" -C "$WORK"
SRC="$WORK/pdfio-${VERSION}"

echo "==> replacing src/vendor/pdfio"
rm -rf "$ROOT/src/vendor/pdfio"
mkdir -p "$ROOT/src/vendor/pdfio"
grep -v '^#' "$ROOT/tools/pdfio-files.txt" | grep -v '^[[:space:]]*$' |
  while read -r f; do
    cp "$SRC/$f" "$ROOT/src/vendor/pdfio/$f"
  done

PATCHES=""
for p in "$ROOT"/tools/patches/*.patch; do
  [ -f "$p" ] || continue
  echo "==> applying $(basename "$p")"
  patch -s -p1 -d "$ROOT/src/vendor/pdfio" < "$p"
  PATCHES="${PATCHES}                 $(basename "$p")
"
done
find "$ROOT/src/vendor/pdfio" \( -name '*.orig' -o -name '*.rej' \) -delete

echo "==> writing src/vendor/PROVENANCE"
cat > "$ROOT/src/vendor/PROVENANCE" <<PEOF
Vendored dependency: pdfio, with its ttf library

  Upstream:      https://github.com/${REPO}
  Version:       ${VERSION}
  Commit:        ${COMMIT}
  Archive:       ${URL}
  SHA-256:       ${SHA}
  Imported:      $(date -u +%Y-%m-%d)
  License:       Apache-2.0 with exceptions (src/vendor/pdfio/LICENSE and
                 src/vendor/pdfio/NOTICE); ttf.c and ttf.h carry the same
  Local patches: applied in this order, from tools/patches/
${PATCHES}
src/vendor/pdfio/ is the files listed in tools/pdfio-files.txt, copied from
the release tarball, with exactly the patches above applied.
tools/verify-vendor re-derives the tree from the pinned tarball and the
patch series and fails on any other difference. Each patch adds a
modification notice to every file it changes (Apache-2.0 section 4(b)).

  0001-visibility-override  _PDFIO_PUBLIC and _PDFIO_PRIVATE can be defined
                            on the command line. pdfio marks its API
                            visibility("default"), which would export it
                            from zupdf.so past \$(C_VISIBILITY); Makevars
                            defines both empty, so only R_init_zupdf is
                            exported.
  0002-no-stdio             PDFIO_NO_STDIO leaves out the default error
                            callback's fprintf(stderr), ttf's errorf()
                            fallback to stderr and the three DEBUG value
                            printers, which R CMD check reports as
                            console output. zupdf always installs its own
                            callbacks, so none of these is reachable.
  0003-date-buffer          The two date buffers grow from 32 to 80 bytes,
                            enough for any int the "D:%04d%02d..." format
                            can print. gcc's -Wformat-truncation, which R
                            CMD check reports, warned that 32 might not be.

0001 and 0002 are proposed upstream as build options and 0003 as a fix;
none changes behaviour.

Only the library is imported: the sixteen pdfio-*.c translation units and
ttf.c, the headers they include, LICENSE and NOTICE. The examples (pdf2text.c
is ported as project code, design D10), tests, test files, documentation,
configure, Makefile.in and IDE projects are deliberately excluded.
HAVE_LIBPNG, HAVE_LIBWEBP and HAVE_GETRANDOM are never defined.

Compiler warnings seen at import (pdfio 1.6.5):
  clang -Wall -pedantic -Wstrict-prototypes: none.
  clang -Wextra adds, not under CRAN's flags and so not patched:
    -Wcast-function-type-mismatch  token consume callbacks cast to
                                   _pdfio_tconsume_cb_t: pdfio-file.c (5),
                                   pdfio-object.c (1), pdfio-stream.c (1)
    -Wnull-pointer-subtraction     pdfio-md5.c:158, an alignment test
PEOF

echo "==> done. Next: tools/verify-vendor, then R CMD check, then tools/check-symbols."
