+		max_objs;		// Most objects to read, 0 for no limit
   pdfio_obj_t	**objs,			// Objects
 		*current_obj;		// Current object being written/read
   size_t	num_objmaps,		// Number of object maps
@@ -442,6 +445,7 @@
